# Copy to .env for local development. Never commit real values.
# With nothing set, AgentMesh runs the local profile: SQLite, in-process stores, mock model.

# --- Core -------------------------------------------------------------------
MESH_ENV=dev                       # dev | prod (prod refuses mock providers and generated keys)
MESH_REGION=us                     # data residency region this deployment serves (us | eu)
MESH_DATA_DIR=.mesh                # local state (SQLite file, generated dev keys)
MESH_ADMIN_KEY=                    # platform admin API key; generated into MESH_DATA_DIR in dev
MESH_SECRET_KEY=                   # 32-byte urlsafe base64 root key for tenant secret encryption

# --- Data stores (production profile) ----------------------------------------
DATABASE_URL=                      # postgresql://mesh_app:...@host/db   (default: sqlite in MESH_DATA_DIR)
DATABASE_PLATFORM_URL=             # postgresql://mesh_platform:...      (BYPASSRLS role for rollups)
REDIS_URL=                         # redis://host:6379/0                 (default: in-process cache)
QDRANT_URL=                        # http://host:6333                    (default: in-process vector index)
KAFKA_BROKERS=                     # host:9092                           (default: SQL meter sink only)
CLICKHOUSE_URL=                    # http://host:8123
VAULT_ADDR=                        # https://vault:8200                  (default: encrypted DB secrets)
VAULT_TOKEN=

# --- Runtime -----------------------------------------------------------------
TEMPORAL_ADDR=                     # host:7233                           (default: built-in journal engine)

# --- Inference ---------------------------------------------------------------
ANTHROPIC_API_KEY=                 # provider API; without it dev falls back to the mock model
VLLM_ENDPOINTS=                    # comma-separated vLLM base URLs for the multi-LoRA fleet

# --- Billing -----------------------------------------------------------------
STRIPE_KEY=                        # Stripe secret key; without it usage is recorded locally only
